---
interface Props {
  name: 'github' | 'linkedin' | 'instagram' | 'email';
}
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  {name === 'github' && (
    <path
      fill="currentColor"
      d="M12 .75a11.25 11.25 0 0 0-3.56 21.93c.56.1.77-.24.77-.54v-2.1c-3.14.68-3.8-1.33-3.8-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.02 1.74 2.68 1.24 3.33.95.1-.74.4-1.24.72-1.52-2.51-.29-5.15-1.26-5.15-5.56 0-1.23.44-2.23 1.16-3.01-.12-.29-.5-1.43.11-2.98 0 0 .94-.3 3.09 1.15a10.8 10.8 0 0 1 5.62 0c2.15-1.45 3.09-1.15 3.09-1.15.61 1.55.23 2.69.11 2.98.72.78 1.15 1.78 1.15 3.01 0 4.31-2.64 5.27-5.16 5.55.41.35.77 1.04.77 2.1v3.12c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z"
    />
  )}
  {name === 'linkedin' && (
    <>
      <rect
        x="2"
        y="2"
        width="20"
        height="20"
        rx="2"
        stroke="currentColor"
        stroke-width="2"
      />
      <circle cx="7" cy="8" r="1.4" fill="currentColor" />
      <path
        d="M7 11v7m5 0v-7m0 3.5a3 3 0 0 1 6 0V18"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect
        x="2"
        y="2"
        width="20"
        height="20"
        rx="5"
        stroke="currentColor"
        stroke-width="2"
      />
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
      <circle cx="18" cy="6" r="1" fill="currentColor" />
    </>
  )}
  {name === 'email' && (
    <>
      <rect
        x="2"
        y="4"
        width="20"
        height="16"
        rx="2"
        stroke="currentColor"
        stroke-width="2"
      />
      <path
        d="m3 6 9 7 9-7"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </>
  )}
</svg>

<style>
  svg {
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 auto;
  }
</style>
