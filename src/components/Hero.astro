---
import { siteConfig } from '../config/site.config';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero__grid container">
    <div class="hero__copy">
      <p class="eyebrow">{siteConfig.hero.eyebrow}</p>
      <h1 id="hero-title">{siteConfig.hero.title}</h1>
      <p class="hero__lead">{siteConfig.hero.description}</p>
      <div class="hero__actions">
        <a
          class="button button--primary"
          href={siteConfig.hero.primaryAction.href}
        >
          {siteConfig.hero.primaryAction.label}
          <span aria-hidden="true">→</span>
        </a>
        <a
          class="button button--secondary"
          href={siteConfig.hero.secondaryAction.href}
        >
          {siteConfig.hero.secondaryAction.label}
        </a>
      </div>
    </div>

    <aside class="hero__note" aria-label="Ejemplo de trabajo">
      <span class="hero__note-index" aria-hidden="true">
        01 / Un caso frecuente
      </span>
      <div>
        <p class="hero__note-question">
          ¿Tu equipo copia los mismos datos una y otra vez?
        </p>
        <strong>{siteConfig.hero.signalTitle}</strong>
        <p>{siteConfig.hero.signalDescription}</p>
      </div>
      <span class="hero__note-end">Empecemos por lo que ya tienes. ↗</span>
    </aside>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }
  .hero__copy {
    max-width: 48rem;
  }
  .hero__lead {
    max-width: 42rem;
    margin-block-end: 0;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }
  .hero__note {
    display: flex;
    min-height: 29rem;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 3px solid var(--color-blue);
    background: var(--color-blue-soft);
  }
  .hero__note-index,
  .hero__note-end {
    color: var(--color-blue-dark);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .hero__note-question {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    line-height: 1.25;
  }
  .hero__note strong {
    color: var(--color-blue-dark);
  }
  .hero__note p:last-child {
    margin: 0.5rem 0 0;
    color: var(--color-muted);
  }
  @media (max-width: 52rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__note {
      min-height: auto;
      max-width: 40rem;
    }
  }
</style>
