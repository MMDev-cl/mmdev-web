---
import { siteConfig } from '../config/site.config';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero__grid container">
    <div class="hero__copy">
      <p class="eyebrow">{siteConfig.hero.eyebrow}</p>
      <h1 id="hero-title">{siteConfig.hero.title}</h1>
      <p class="hero__lead">{siteConfig.hero.description}</p>
      <div class="hero__actions">
        <a
          class="button button--primary"
          href={siteConfig.hero.primaryAction.href}
        >
          {siteConfig.hero.primaryAction.label}
          <span aria-hidden="true">→</span>
        </a>
        <a
          class="button button--secondary"
          href={siteConfig.hero.secondaryAction.href}
        >
          {siteConfig.hero.secondaryAction.label}
        </a>
      </div>
    </div>

    <div
      class="hero__system"
      aria-label="Áreas tecnológicas conectadas por MM Dev"
    >
      <div class="hero__system-head">
        <span>MM DEV / SYSTEMS</span>
        <span>CL</span>
      </div>
      <div class="hero__map" aria-hidden="true">
        <span class="hero__node hero__node--one">Software</span>
        <span class="hero__node hero__node--two">Integraciones</span>
        <span class="hero__node hero__node--three">Infraestructura</span>
        <span class="hero__core">MM</span>
      </div>
      <div class="hero__signal">
        <strong>{siteConfig.hero.signalTitle}</strong>
        <span>{siteConfig.hero.signalDescription}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    padding-block: clamp(4.5rem, 10vw, 8.5rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }
  .hero__copy {
    max-width: 48rem;
  }
  .hero__lead {
    max-width: 42rem;
    margin-block-end: 0;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }
  .hero__system {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: 1.5rem 1.5rem 0 var(--color-blue-soft);
  }
  .hero__system-head {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted);
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .hero__map {
    position: relative;
    min-height: 18rem;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
  }
  .hero__core,
  .hero__node {
    position: absolute;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .hero__core {
    inset: 50% auto auto 50%;
    width: 4.5rem;
    height: 4.5rem;
    transform: translate(-50%, -50%);
    border-color: var(--color-navy);
    background: var(--color-navy);
    color: var(--color-on-dark);
    font-size: 1.1rem;
  }
  .hero__node {
    padding: 0.45rem 0.6rem;
    color: var(--color-muted);
  }
  .hero__node--one {
    inset: 12% auto auto 8%;
  }
  .hero__node--two {
    inset: 20% 7% auto auto;
  }
  .hero__node--three {
    inset: auto auto 12% 12%;
  }
  .hero__map::before,
  .hero__map::after {
    position: absolute;
    content: '';
    background: var(--color-blue);
    opacity: 0.55;
  }
  .hero__map::before {
    inset: 50% 18% auto 18%;
    height: 1px;
  }
  .hero__map::after {
    inset: 20% auto 18% 50%;
    width: 1px;
  }
  .hero__signal {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem;
    border-top: 3px solid var(--color-blue);
    background: var(--color-blue-soft);
  }
  .hero__signal strong {
    font-family: var(--font-heading);
  }
  .hero__signal span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  @media (max-width: 52rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__system {
      max-width: 34rem;
    }
  }
</style>
