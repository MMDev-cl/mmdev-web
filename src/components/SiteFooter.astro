---
import { siteConfig } from '../config/site.config';
const year = new Date().getUTCFullYear();
---

<footer class="simple-footer container">
  <span>© {year} Manuel Matus</span>
  <a href="/privacidad/">Privacidad</a>
  <button type="button" data-open-privacy-preferences>
    Configurar cookies
  </button>
  <span class="simple-footer__legal">
    Servicios contratados y facturados por {siteConfig.brand.legalName}.
  </span>
</footer>
<style>
  .simple-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .simple-footer a,
  .simple-footer button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-highlight);
    cursor: pointer;
    text-decoration: underline;
  }
  .simple-footer__legal {
    width: 100%;
  }
</style>
