---
import { siteConfig } from '../config/site.config';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section class="contact" id="contacto" aria-labelledby="contact-title">
  <p class="contact__eyebrow">Contacto directo</p>
  <h2 id="contact-title">{siteConfig.contact.title}</h2>
  <p class="contact__lead">{siteConfig.contact.description}</p>
  <form
    class="contact-form"
    action="/api/contact"
    method="post"
    data-contact-form
  >
    <div class="contact-form__field">
      <label for="name">Nombre</label>
      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        maxlength="100"
        placeholder="Nombre"
        required
      />
    </div>
    <div class="contact-form__field">
      <label for="email">Correo</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        maxlength="160"
        placeholder="Correo"
        required
      />
    </div>
    <div class="contact-form__field">
      <label for="phone">Teléfono (opcional)</label>
      <input
        id="phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        maxlength="40"
        placeholder="Teléfono (opcional)"
      />
    </div>
    <div class="contact-form__field contact-form__field--wide">
      <label for="message">¿En qué puedo ayudarte?</label>
      <textarea
        id="message"
        name="message"
        rows="5"
        minlength="10"
        maxlength="3000"
        placeholder="Cuéntame brevemente qué tienes en mente…"
        required
      ></textarea>
    </div>

    <div class="contact-form__trap" aria-hidden="true">
      <label for="website">Sitio web</label>
      <input
        id="website"
        name="website"
        type="text"
        autocomplete="off"
        tabindex="-1"
      />
    </div>

    <label class="contact-form__consent">
      <input name="consent" type="checkbox" required />
      <span>
        Acepto que mis datos se usen solo para responderme. Puedes conocer los
        detalles en el <a href="/privacidad/">aviso de privacidad</a>.
      </span>
    </label>

    {turnstileSiteKey ? (
      <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-theme="dark"
        data-action="contact"
      ></div>
    ) : null}

    <p class="contact-form__alternative">
      También puedes escribir directamente a{' '}
      <a href={`mailto:${siteConfig.contact.email}`}>
        {siteConfig.contact.email}
      </a>
      .
    </p>

    <div class="contact-form__footer">
      <button
        class="button button--primary"
        type="submit"
        disabled={!turnstileSiteKey}
      >
        Enviar mensaje <span aria-hidden="true">↗</span>
      </button>
      <p
        class="contact-form__status"
        role="status"
        aria-live="polite"
        data-form-status
      ></p>
    </div>
  </form>
</section>

{turnstileSiteKey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !form.reportValidity()) return;

    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const payload = Object.fromEntries(new FormData(form).entries());

    status.dataset.state = 'loading';
    status.textContent = 'Enviando consulta…';
    if (button) button.disabled = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const result = (await response.json()) as { message?: string };
      if (!response.ok)
        throw new Error(result.message || 'No fue posible enviar la consulta.');

      form.reset();
      status.dataset.state = 'success';
      status.textContent =
        result.message || 'Consulta enviada. Le responderemos a la brevedad.';
      window.turnstile?.reset();
    } catch (error) {
      status.dataset.state = 'error';
      status.textContent =
        error instanceof Error
          ? error.message
          : 'No fue posible enviar la consulta.';
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .contact {
    width: 100%;
    max-width: 38rem;
    margin-block: auto;
    padding-block: clamp(4rem, 10vh, 8rem);
  }
  .contact__eyebrow {
    margin-bottom: 1.1rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .contact h2 {
    max-width: 34rem;
    margin-bottom: 1rem;
    font-size: clamp(2.7rem, 4vw, 4.4rem);
    line-height: 1.1;
    letter-spacing: -0.055em;
  }
  .contact__lead {
    max-width: 31rem;
    margin-bottom: 0.5rem;
    color: var(--color-muted);
    font-size: 1.08rem;
  }
  .contact-form {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.3rem;
    margin-top: 2.5rem;
  }
  .contact-form__field {
    display: grid;
    gap: 0.45rem;
  }
  .contact-form__field:not(.contact-form__field--wide) label {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    white-space: nowrap;
    clip-path: inset(50%);
  }
  .contact-form__field--wide,
  .contact-form__consent,
  .contact-form__alternative,
  .cf-turnstile,
  .contact-form__footer {
    grid-column: 1 / -1;
  }
  .contact-form label {
    color: var(--color-main);
    font-size: 0.87rem;
    font-weight: 600;
  }
  .contact-form label span {
    color: var(--color-muted);
    font-weight: 400;
  }
  .contact-form input,
  .contact-form textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    background: var(--color-panel);
    color: var(--color-main);
  }
  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: var(--color-muted);
  }
  .contact-form textarea {
    min-height: 8rem;
    resize: vertical;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--color-accent);
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .contact-form__consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
  }
  .contact-form__consent input {
    width: 1.15rem;
    min-height: 1.15rem;
    margin-top: 0.2rem;
    accent-color: var(--color-accent);
  }
  .contact-form__consent span {
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 400;
  }
  .contact-form__consent a {
    color: var(--color-highlight);
  }
  .contact-form__trap {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
  }
  .contact-form__alternative {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .contact-form__alternative a {
    color: var(--color-highlight);
    text-underline-offset: 0.25rem;
  }
  .contact-form__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .contact-form__status {
    margin: 0;
    font-size: 0.85rem;
  }
  .contact-form__status[data-state='success'] {
    color: var(--color-success);
  }
  .contact-form__status[data-state='error'] {
    color: var(--color-error);
  }
  @media (max-width: 36rem) {
    .contact {
      padding-block: 3rem;
    }
    .contact-form {
      grid-template-columns: 1fr;
    }
  }
</style>
