---
import { measurementConfig } from '../config/measurement.config';
---

<section
  class="privacy-preferences"
  data-privacy-preferences
  data-preferences-open-event={measurementConfig.preferencesOpenEvent}
  data-consent-change-event={measurementConfig.consentChangeEvent}
  role="region"
  aria-labelledby="privacy-preferences-title"
  aria-describedby="privacy-preferences-description"
  aria-live="polite"
  aria-atomic="true"
  hidden
>
  <div class="privacy-preferences__content">
    <button
      class="privacy-preferences__close"
      type="button"
      aria-label="Cerrar preferencias de privacidad"
      data-privacy-preferences-close
      hidden
    >
      ×
    </button>
    <div>
      <h2 id="privacy-preferences-title" tabindex="-1">
        Tu privacidad, tu decisión
      </h2>
      <p id="privacy-preferences-description">
        Si aceptas, usamos cookies para saber cómo se utiliza el sitio y
        mejorarlo. Si rechazas, puedes seguir navegando igual. Puedes cambiar de
        opinión cuando quieras.
      </p>
      <a href="/privacidad/">Cómo cuidamos tus datos</a>
    </div>
    <div class="privacy-preferences__actions">
      <button
        class="button button--primary"
        type="button"
        data-analytics-consent="granted"
      >
        Aceptar
      </button>
      <button
        class="button button--secondary"
        type="button"
        data-analytics-consent="denied"
      >
        Rechazar
      </button>
    </div>
    <p
      class="privacy-preferences__status"
      data-privacy-preferences-status
      role="status"
      aria-live="polite"
    ></p>
  </div>
</section>

<script>
  const preferences = document.querySelector<HTMLElement>(
    '[data-privacy-preferences]',
  );
  const closeButton = preferences?.querySelector<HTMLButtonElement>(
    '[data-privacy-preferences-close]',
  );
  const status = preferences?.querySelector<HTMLElement>(
    '[data-privacy-preferences-status]',
  );
  const consentButtons = preferences?.querySelectorAll<HTMLButtonElement>(
    '[data-analytics-consent]',
  );
  const firstConsentButton = preferences?.querySelector<HTMLButtonElement>(
    '[data-analytics-consent="granted"]',
  );
  const preferencesOpenEvent = preferences?.dataset.preferencesOpenEvent;
  const consentChangeEvent = preferences?.dataset.consentChangeEvent;
  let returnFocusTo: HTMLElement | null = null;

  const hasPersistedDecision = () =>
    window.mmdevMeasurement.getAnalyticsConsent() !== null;

  const openPreferences = (returnFocus = true) => {
    if (!preferences) return;

    if (returnFocus && document.activeElement instanceof HTMLElement) {
      returnFocusTo = document.activeElement;
    }

    preferences.hidden = false;
    if (closeButton) closeButton.hidden = !hasPersistedDecision();
    if (status) status.textContent = '';
    if (returnFocus) firstConsentButton?.focus({ preventScroll: true });
  };

  const closePreferences = () => {
    if (!preferences || !hasPersistedDecision()) return;

    preferences.hidden = true;
    returnFocusTo?.focus();
    returnFocusTo = null;
  };

  const showPersistenceError = () => {
    openPreferences(false);
    if (status) {
      status.textContent =
        'No pudimos guardar tu decisión. La medición sigue desactivada durante esta sesión.';
    }
  };

  if (preferencesOpenEvent) {
    document.addEventListener(preferencesOpenEvent, () => {
      window.mmdevMeasurement.consumePendingPreferencesOpen();
      openPreferences();
    });
  }

  if (consentChangeEvent) {
    document.addEventListener(consentChangeEvent, () => {
      if (hasPersistedDecision()) closePreferences();
      else showPersistenceError();
    });
  }

  document.addEventListener('click', (event) => {
    if (
      event.target instanceof Element &&
      event.target.closest('[data-open-privacy-preferences]')
    ) {
      openPreferences();
    }
  });

  closeButton?.addEventListener('click', closePreferences);

  preferences?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && hasPersistedDecision()) {
      event.preventDefault();
      closePreferences();
    }
  });

  consentButtons?.forEach((button) => {
    button.addEventListener('click', () => {
      const analytics = button.dataset.analyticsConsent;
      if (analytics !== 'granted' && analytics !== 'denied') return;

      const result = window.mmdevMeasurement.setAnalyticsConsent(analytics);
      if (!result.persisted) {
        showPersistenceError();
        return;
      }

      if (!result.reloading) closePreferences();
    });
  });

  if (window.mmdevMeasurement.consumePendingPreferencesOpen()) {
    openPreferences();
  } else if (!hasPersistedDecision()) {
    openPreferences(false);
  }
</script>

<style>
  .privacy-preferences {
    position: fixed;
    z-index: 50;
    inset: auto 1rem 1rem;
    max-width: 66rem;
    margin-inline: auto;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: 0 0.5rem 2rem rgb(23 45 52 / 16%);
  }
  .privacy-preferences[hidden] {
    display: none;
  }
  .privacy-preferences__content {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1.5rem;
    padding: 1rem 1.25rem;
  }
  .privacy-preferences h2 {
    margin-block-end: 0.25rem;
    font-size: 1.35rem;
  }
  .privacy-preferences p {
    margin-block-end: 0.25rem;
    color: var(--color-muted);
  }
  .privacy-preferences a {
    color: var(--color-blue-dark);
    font-weight: 600;
    text-underline-offset: 0.2rem;
  }
  .privacy-preferences__close {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-end: 0.75rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
  }
  .privacy-preferences__actions {
    display: flex;
    flex-wrap: wrap;
    min-width: 14rem;
    gap: 0.5rem;
    align-content: center;
    align-items: center;
  }
  .privacy-preferences__status {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-error);
    font-size: 0.875rem;
  }
  @media (max-width: 48rem) {
    .privacy-preferences {
      inset: auto 0 0;
      border-inline: 0;
      border-block-end: 0;
    }
    .privacy-preferences__content {
      grid-template-columns: 1fr;
    }
    .privacy-preferences__content:has(
      .privacy-preferences__close:not([hidden])
    ) {
      padding-inline-end: 3.5rem;
    }
    .privacy-preferences__actions {
      min-width: 0;
      padding-inline-end: 0;
    }
    .privacy-preferences__actions .button {
      width: auto;
      min-width: 7rem;
    }
  }
</style>
