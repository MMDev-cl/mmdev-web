---
import Contact from './Contact.astro';
import SocialIcon from './SocialIcon.astro';
import { siteConfig } from '../config/site.config';

const { person, contact } = siteConfig;
---

<header class="personal-header">
  <a class="personal-header__wordmark" href="/" aria-label="M.dev, inicio">
    <span class="personal-header__symbol" aria-hidden="true">
      M.
    </span>
    <span>dev</span>
  </a>
</header>

<main class="personal-layout" id="contenido-principal">
  <aside class="personal-intro" aria-labelledby="personal-name">
    <div class="personal-intro__identity">
      {person.portrait ? (
        <img
          class="personal-intro__portrait"
          src={person.portrait}
          alt="Retrato de Manuel Matus"
          width="100"
          height="100"
          fetchpriority="high"
        />
      ) : (
        <span
          class="personal-intro__portrait personal-intro__portrait--initials"
          aria-hidden="true"
        >
          MM
        </span>
      )}
      <p class="personal-intro__eyebrow">
        Desarrollo · Integraciones · Automatización
      </p>
      <h1 id="personal-name">{person.name}</h1>
      <p class="personal-intro__role">{person.role}</p>
      <p class="personal-intro__specialty">{person.specialty}</p>
      <p class="personal-intro__description">{person.introduction}</p>
    </div>
  </aside>

  <div class="personal-content">
    <Contact />
  </div>
</main>

<footer class="personal-footer">
  <div class="personal-footer__inner">
    <nav class="personal-footer__links" aria-label="Perfiles de Manuel Matus">
      <a href={person.github} target="_blank" rel="noopener noreferrer">
        <SocialIcon name="github" /> GitHub
      </a>
      {person.linkedin && (
        <a href={person.linkedin} target="_blank" rel="noopener noreferrer">
          <SocialIcon name="linkedin" /> LinkedIn
        </a>
      )}
      {person.instagram && (
        <a href={person.instagram} target="_blank" rel="noopener noreferrer">
          <SocialIcon name="instagram" /> Instagram
        </a>
      )}
      <a href={`mailto:${contact.email}`}>
        <SocialIcon name="email" /> Correo
      </a>
    </nav>
    <nav class="personal-footer__privacy" aria-label="Privacidad y cookies">
      <a href="/privacidad/">Privacidad</a>
      <button type="button" data-open-privacy-preferences>
        Cookies
      </button>
    </nav>
  </div>
</footer>

<style>
  .personal-header {
    width: min(100% - 4rem, 82rem);
    margin-inline: auto;
    padding-top: 2rem;
  }
  .personal-layout {
    display: grid;
    width: min(100% - 4rem, 82rem);
    grid-template-columns: minmax(19rem, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(3rem, 7vw, 8rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 7vh, 5rem) 9rem;
  }
  .personal-intro {
    align-self: center;
  }
  .personal-header__wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    font-size: 1.2rem;
    font-weight: 700;
    text-decoration: none;
  }
  .personal-header__symbol {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-size: 1.4rem;
  }
  .personal-intro__identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .personal-intro__portrait {
    display: grid;
    width: 6rem;
    height: 6rem;
    margin-bottom: 2.5rem;
    margin-inline: auto;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    object-fit: cover;
  }
  .personal-intro__portrait--initials {
    place-items: center;
    background: var(--color-panel);
    color: var(--color-accent);
    font-size: 1.45rem;
    font-weight: 700;
  }
  .personal-intro__eyebrow {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .personal-intro h1 {
    margin: 0.8rem 0 0;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
  }
  .personal-intro__role {
    margin: 0.9rem 0 0;
    color: var(--color-highlight);
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    font-weight: 600;
  }
  .personal-intro__specialty {
    max-width: 26rem;
    margin: 0.8rem 0 0;
    color: var(--color-main);
    font-size: 1.05rem;
  }
  .personal-intro__description {
    max-width: 28rem;
    margin: 1.75rem 0 0;
    color: var(--color-muted);
  }
  .personal-footer {
    position: fixed;
    z-index: 10;
    inset: auto 0 0;
    border-top: 1px solid var(--color-border);
    background: var(--color-background);
  }
  .personal-footer__inner {
    display: flex;
    width: min(100% - 4rem, 82rem);
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-inline: auto;
  }
  .personal-footer__links,
  .personal-footer__privacy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }
  .personal-footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-main);
    font-size: 0.9rem;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.35rem;
  }
  .personal-footer__links a:hover,
  .personal-footer__links a:focus-visible {
    color: var(--color-accent);
  }
  .personal-content {
    min-width: 0;
  }
  .personal-footer__privacy a,
  .personal-footer__privacy button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  .personal-footer__privacy a:hover,
  .personal-footer__privacy button:hover,
  .personal-footer__privacy a:focus-visible,
  .personal-footer__privacy button:focus-visible {
    color: var(--color-accent);
  }
  @media (max-width: 56rem) {
    .personal-header,
    .personal-layout {
      width: min(100% - 2.5rem, 42rem);
    }
    .personal-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-block: 3rem 10rem;
    }
    .personal-intro__portrait {
      margin-bottom: 1.5rem;
    }
    .personal-footer__inner {
      width: min(100% - 2.5rem, 42rem);
    }
  }
  @media (max-width: 36rem) {
    .personal-footer__inner {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 1.5rem;
      padding-block: 0.8rem;
    }
    .personal-footer__links,
    .personal-footer__privacy {
      justify-content: center;
    }
    .personal-layout {
      padding-bottom: 12rem;
    }
  }
</style>
