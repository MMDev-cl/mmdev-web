---
import BrandMark from './BrandMark.astro';
---

<header class="simple-header">
  <BrandMark />
  <a class="simple-header__back" href="/">
    ← Inicio
  </a>
</header>
<style>
  .simple-header {
    display: flex;
    width: min(100% - 4rem, 82rem);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: auto;
    padding-top: 2rem;
  }
  .simple-header__back {
    color: var(--color-highlight);
    font-weight: 700;
    text-decoration: none;
  }
  .simple-header__back:hover {
    text-decoration: underline;
  }
  @media (max-width: 56rem) {
    .simple-header {
      width: min(100% - 2.5rem, 42rem);
    }
  }
</style>
